{
  "schemaVersion": 1,
  "id": "leicraftclient",
  "version": "${version}",
  "name": "LeiCraftClient",
  "description": "Custom capes and cosmetics for LeiCraft, served by the LeiCraft cosmetics backend. Reads the same OptiFine-style model and cape formats the previous client used.",
  "authors": [
    "LeiCraft"
  ],
  "contact": {
    "homepage": "https://client.leicraftmc.de"
  },
  "license": "AGPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.leicraftmc.leicraftclient.client.MainClient"
    ],
    "main": [
      "de.leicraftmc.leicraftclient.Main"
    ]
  },
  "mixins": [
    "leicraftclient.mixins.json",
    {
      "config": "leicraftclient.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
